    },
    {
      "args": [
        1,
        7,
      ],
      "op": "all",
      "sql": "SELECT DISTINCT phase FROM discoveries WHERE user_id = ? AND species_id = ?",
    },
    {
      "args": [
        "DX-DLT-DLT",
        1,
        7,
        "balance",
        1,
        "/species-art/rex/balance.webp",
      ],
      "op": "run",
      "sql": "INSERT INTO discoveries (discovery_code, user_id, species_id, phase, rarity_tier_id, image_url) VALUES (?, ?, ?, ?, ?, ?)",
    },
    {
      "args": [
        99,
      ],
      "op": "first",
      "sql": "SELECT discovered_at FROM discoveries WHERE id = ?",
    },
    {
      "args": [
        1,
        7,
      ],
      "op": "first",
      "sql": "SELECT COUNT(*) as balance_count FROM discoveries WHERE user_id = ? AND species_id = ? AND phase = 'balance' AND consumed_at IS NULL",
    },
    {
      "args": [
        1,
        7,
      ],
      "op": "all",
      "sql": "SELECT DISTINCT phase FROM discoveries WHERE user_id = ? AND species_id = ?",
    },
    {
      "args": [
        1,
        "percibir",
        "2026-11-17",
      ],
      "op": "run",
      "sql": "INSERT INTO daily_missions (user_id, mission_slug, day, progress_count) VALUES (?, ?, ?, 1) ON CONFLICT (user_id, mission_slug, day) DO UPDATE SET progress_count = progress_count + 1",
    },
    {
      "args": [
        1,
        "percibir",
        "2026-11-17",
      ],
      "op": "first",
      "sql": "SELECT progress_count, completed_at FROM daily_missions WHERE user_id = ? AND mission_slug = ? AND day = ?",
    },
    {
      "args": [
        1,
        "percibir",
        "2026-11-17",
      ],
      "op": "run",
      "sql": "UPDATE daily_missions SET completed_at = datetime('now') WHERE user_id = ? AND mission_slug = ? AND day = ?",
    },
    {
      "args": [
        1,
        "coleccionista",
        "2026-11-17",
      ],
      "op": "run",
      "sql": "INSERT INTO daily_missions (user_id, mission_slug, day, progress_count) VALUES (?, ?, ?, 1) ON CONFLICT (user_id, mission_slug, day) DO UPDATE SET progress_count = progress_count + 1",
    },
    {
      "args": [
        1,
        "coleccionista",
        "2026-11-17",
      ],
      "op": "first",
      "sql": "SELECT progress_count, completed_at FROM daily_missions WHERE user_id = ? AND mission_slug = ? AND day = ?",
    },
    {
      "args": [
        1,
        "2026-11-17",
      ],
      "op": "all",
      "sql": "SELECT mission_slug, completed_at FROM daily_missions WHERE user_id = ? AND day = ?",
    },
    {
      "args": [
        1,
        "2026-11-17",
        120,
      ],
      "op": "all",
      "sql": "SELECT DISTINCT day FROM daily_missions WHERE user_id = ? AND day <= ? ORDER BY day DESC LIMIT ?",
    },
    {
      "args": [
        1,
      ],
      "op": "first",
      "sql": "SELECT xp FROM users WHERE id = ?",
    },
    {
      "args": [
        10,
        1,
      ],
      "op": "run",
      "sql": "UPDATE users SET xp = xp + ? WHERE id = ?",
    },
    {
      "args": [
        1,
      ],
      "op": "first",
      "sql": "SELECT xp FROM users WHERE id = ?",
    },
  ],
  "status": 201,
}
`;


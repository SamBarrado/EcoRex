      "args": [
        2,
        1794916800000,
        2,
        1,
      ],
      "op": "run",
      "sql": "UPDATE users SET energy_count = ?, energy_window_start = ?, energy_last_notified_count = ? WHERE id = ?",
    },
    {
      "args": [],
      "op": "all",
      "sql": "SELECT id FROM species WHERE is_active = 1",
    },
    {
      "args": [
        7,
        "balance",
      ],
      "op": "first",
      "sql": "SELECT species.id as species_id, species.scientific_name as scientific_name, species.common_name as common_name, fractae.child_name as fractae_child_name, species_phase_anchors.image_url as anchor_image_url, species_phase_anchors.lore_phrase as lore_phrase FROM species JOIN fractae ON fractae.id = species.fractae_id JOIN species_phase_anchors ON species_phase_anchors.species_id = species.id WHERE species.id = ? AND species_phase_anchors.phase = ? AND species.is_active = 1",
    },
    {
      "args": [],
      "op": "all",
      "sql": "SELECT id, slug, name, drop_weight FROM rarity_tiers",
    },
    {

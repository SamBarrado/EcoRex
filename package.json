{
  "name": "ecorex-project",
  "private": true,
  "version": "0.10.0",
  "scripts": {
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.functions.json --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "vite:dev": "vite",
    "dev": "npm run build && wrangler pages dev dist",
    "species:art": "node tools/species/generate-species-art.mjs",
    "species:art:layered": "node tools/species/generate-species-art-layered.mjs",
    "species:spec": "node tools/species/generate-species-spec.mjs",
    "species:discover": "node tools/species/discover-species-pbdb.mjs",
    "db:sync-species": "node tools/species/sync-species-db.mjs",
    "db:seed": "wrangler d1 execute DB --local --file=scripts/seed.sql",
    "db:seed:remote": "wrangler d1 execute DB --remote --file=scripts/seed.sql",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:migrate:status": "wrangler d1 migrations list DB --local && wrangler d1 migrations list DB --remote",
    "db:migrate:new": "wrangler d1 migrations create DB"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250704.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.0",
    "vite": "^8.1.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9",
    "wrangler": "^4.107.0"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^1.0.2",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  }
}

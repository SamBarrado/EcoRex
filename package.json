{
  "name": "ecorex-project",
  "private": true,
  "version": "0.14.1",
  "scripts": {
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.functions.json --noEmit && tsc -p tsconfig.admin-app.json --noEmit && tsc -p tsconfig.admin-functions.json --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "vite:dev": "vite",
    "dev": "npm run build && wrangler pages dev dist",
    "admin:build": "vite build --config admin/vite.config.ts",
    "admin:dev": "npm run admin:build && cd admin && wrangler pages dev dist --port 8789 --persist-to ../.wrangler/state",
    "species:art": "node tools/species/generate-species-art.mjs",
    "species:art:layered": "node tools/species/generate-species-art-layered.mjs",
    "species:spec": "node tools/species/generate-species-spec.mjs",
    "db:sync-species": "node tools/species/sync-species-db.mjs",
    "db:seed": "wrangler d1 execute DB --local --file=scripts/seed.sql",
    "db:retention": "wrangler d1 execute DB --local --file=scripts/retention.sql",
    "db:retention:remote": "wrangler d1 execute DB --remote --file=scripts/retention.sql",
    "db:seed:remote": "wrangler d1 execute DB --remote --file=scripts/seed.sql",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:remote": "wrangler d1 migrations apply DB --remote",
    "db:migrate:status": "wrangler d1 migrations list DB --local && wrangler d1 migrations list DB --remote",
    "db:migrate:new": "wrangler d1 migrations create DB"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261119.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "jsdom": "^31.0.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.8",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^5.1.1",
    "wrangler": "^4.165.0"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "^1.0.2",
    "@fontsource/barlow": "^5.3.0",
    "@fontsource/barlow-condensed": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6"
  }
}

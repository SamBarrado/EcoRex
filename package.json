{
  "name": "ecorex-project",
  "private": true,
  "version": "0.7.0",
  "scripts": {
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.functions.json --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "vite:dev": "vite",
    "dev": "npm run build && wrangler pages dev dist",
    "species:art": "node scripts/generate-species-art.mjs",
    "species:art:layered": "node scripts/generate-species-art-layered.mjs",
    "species:spec": "node scripts/generate-species-spec.mjs",
    "species:discover": "node scripts/discover-species-pbdb.mjs",
    "db:sync-species": "node scripts/sync-species-db.mjs",
    "db:seed": "wrangler d1 execute DB --local --file=scripts/seed.sql",
    "db:seed:remote": "wrangler d1 execute DB --remote --file=scripts/seed.sql",
    "db:check-remote-schema": "node scripts/check-remote-schema.mjs"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250704.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "jsdom": "^29.1.1",
    "typescript": "^5.7.0",
    "vite": "^8.1.3",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.9",
    "wrangler": "^4.107.0"
  },
  "dependencies": {
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.1"
  }
}
